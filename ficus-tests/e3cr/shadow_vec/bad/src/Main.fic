port module Main exposing (main)

-- refused: a port of the project's own type (no overlay marker) gets Elm's payload error, as any custom type

import Vector exposing (Vector)


port vOut : Vector Int -> Cmd msg


main : Program () () ()
main =
    Platform.worker
        { init = \_ -> ( (), vOut (Vector.fromList [ 1, 2 ]) )
        , update = \_ m -> ( m, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
