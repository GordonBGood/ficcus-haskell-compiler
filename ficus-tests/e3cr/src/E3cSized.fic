port module E3cSized exposing (main)

-- E3c (D5, D6): the sized integers, Word64 and Float32 through ports, in and out, alone and inside a record, a Maybe, a List and a
-- tuple. Each value that comes in goes out again on its own port, and as text on `output` (the type's toString). The Elm twin
-- (effects_e3c.py `twin`) is this program with Int and Float in place of the Ficus types: equal output for values in range.

import Float32 exposing (Float32)
import Int16 exposing (Int16)
import Int32 exposing (Int32)
import Int8 exposing (Int8)
import Word16 exposing (Word16)
import Word32 exposing (Word32)
import Word64 exposing (Word64)
import Word8 exposing (Word8)


port output : String -> Cmd msg


port i8Out : Int8 -> Cmd msg


port i16Out : Int16 -> Cmd msg


port i32Out : Int32 -> Cmd msg


port w8Out : Word8 -> Cmd msg


port w16Out : Word16 -> Cmd msg


port w32Out : Word32 -> Cmd msg


port w64Out : Word64 -> Cmd msg


port f32Out : Float32 -> Cmd msg


port recOut : Rec -> Cmd msg


port i8In : (Int8 -> msg) -> Sub msg


port i16In : (Int16 -> msg) -> Sub msg


port i32In : (Int32 -> msg) -> Sub msg


port w8In : (Word8 -> msg) -> Sub msg


port w16In : (Word16 -> msg) -> Sub msg


port w32In : (Word32 -> msg) -> Sub msg


port w64In : (Word64 -> msg) -> Sub msg


port f32In : (Float32 -> msg) -> Sub msg


port recIn : (Rec -> msg) -> Sub msg


type alias Rec =
    { a : Int8, b : Word64, c : Maybe Float32, d : List Word16, e : ( Int32, Word8 ) }


type Msg
    = I8 Int8
    | I16 Int16
    | I32 Int32
    | W8 Word8
    | W16 Word16
    | W32 Word32
    | W64 Word64
    | F32 Float32
    | R Rec


update : Msg -> () -> ( (), Cmd Msg )
update msg m =
    case msg of
        I8 x ->
            ( m, Cmd.batch [ output ("i8 " ++ Int8.toString x), i8Out x ] )

        I16 x ->
            ( m, Cmd.batch [ output ("i16 " ++ Int16.toString x), i16Out x ] )

        I32 x ->
            ( m, Cmd.batch [ output ("i32 " ++ Int32.toString x), i32Out x ] )

        W8 x ->
            ( m, Cmd.batch [ output ("w8 " ++ Word8.toString x), w8Out x ] )

        W16 x ->
            ( m, Cmd.batch [ output ("w16 " ++ Word16.toString x), w16Out x ] )

        W32 x ->
            ( m, Cmd.batch [ output ("w32 " ++ Word32.toString x), w32Out x ] )

        W64 x ->
            ( m, Cmd.batch [ output ("w64 " ++ Word64.toString x), w64Out x ] )

        F32 x ->
            ( m, Cmd.batch [ output ("f32 " ++ Float32.toString x), f32Out x ] )

        R r ->
            ( m, Cmd.batch [ output ("rec " ++ Int8.toString r.a ++ " " ++ Word64.toString r.b ++ " " ++ String.fromInt (List.length r.d)), recOut r ] )


main : Program () () Msg
main =
    Platform.worker
        { init = \_ -> ( (), Cmd.none )
        , update = update
        , subscriptions =
            \_ ->
                Sub.batch
                    [ i8In I8, i16In I16, i32In I32, w8In W8, w16In W16, w32In W32, w64In W64, f32In F32, recIn R ]
        }
