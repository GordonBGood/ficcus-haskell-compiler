-- Fannkuch-redux: the Computer Language Benchmarks Game program.
-- compile with elm make src/Fannkuch.elm --output=fannkuch.js
{-
   For every permutation of 1..n (generated by the benchmark's rotation scheme) count the
   "pancake flips" (reverse the first k elements, k being the first element, until the first
   element is 1 -- here the elements are 0 based, so until it is 0). The checksum adds the
   flip count for even permutation numbers and subtracts it for odd ones; the result also
   gives the maximum flip count. Only Int arithmetic and Array get/set are used.
   Published results: n = 7: 228 and 16; n = 10: 73196 and 38; n = 12: 3968050 and 65.
-}


module Fannkuch exposing (main)

import Array exposing (Array)


size : Int
size =
    10


get : Int -> Array Int -> Int
get i a =
    Array.get i a |> Maybe.withDefault 0


{-| Reverse the elements 0 to k inclusive. -}
reverseTo : Int -> Int -> Array Int -> Array Int
reverseTo i j p =
    if i >= j then
        p

    else
        let
            pi =
                get i p

            pj =
                get j p
        in
        reverseTo (i + 1) (j - 1) (p |> Array.set i pj |> Array.set j pi)


flips : Int -> Array Int -> Int
flips cnt p =
    let
        k =
            get 0 p
    in
    if k == 0 then
        cnt

    else
        flips (cnt + 1) (reverseTo 0 k p)


{-| Elements 1 to r move down one place, the first goes to place r. -}
rotate : Int -> Int -> Int -> Array Int -> Array Int
rotate i r p0 p =
    if i >= r then
        Array.set r p0 p

    else
        rotate (i + 1) r p0 (Array.set i (get (i + 1) p) p)


setCounts : Int -> Array Int -> Array Int
setCounts r count =
    if r == 1 then
        count

    else
        setCounts (r - 1) (Array.set (r - 1) r count)


nextPerm : Int -> Array Int -> Array Int -> Maybe ( Array Int, Array Int, Int )
nextPerm r perm1 count =
    if r == size then
        Nothing

    else
        let
            rotated =
                rotate 0 r (get 0 perm1) perm1

            cr =
                get r count - 1

            count2 =
                Array.set r cr count
        in
        if cr > 0 then
            Just ( rotated, count2, r )

        else
            nextPerm (r + 1) rotated count2


search : Int -> Array Int -> Array Int -> Int -> Int -> Int -> ( Int, Int )
search r perm1 count pc cs mx =
    let
        count2 =
            setCounts r count

        f =
            flips 0 perm1

        cs2 =
            if modBy 2 pc == 0 then
                cs + f

            else
                cs - f

        mx2 =
            max mx f
    in
    case nextPerm 1 perm1 count2 of
        Nothing ->
            ( cs2, mx2 )

        Just ( p, c, r2 ) ->
            search r2 p c (pc + 1) cs2 mx2


fannkuch : () -> ( Int, Int )
fannkuch () =
    search size (Array.initialize size identity) (Array.repeat size 0) 0 0 0


tell : String -> ()
tell s =
    Debug.log s ()


main : Program () () ()
main =
    Platform.worker
        { init =
            \_ ->
                let
                    ( checksum, maxFlips ) =
                        fannkuch ()

                    _ =
                        tell (String.fromInt checksum)

                    _ =
                        tell ("Pfannkuchen(" ++ String.fromInt size ++ ") = " ++ String.fromInt maxFlips)
                in
                ( (), Cmd.none )
        , update = \_ _ -> ( (), Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
