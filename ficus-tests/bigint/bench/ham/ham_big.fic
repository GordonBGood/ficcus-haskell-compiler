-- hamnth: the nth Hamming number (2^i 3^j 5^k, in increasing order, 1 first) by the linear three pointer merge.
-- compile with the Ficus compiler: elm make src/HamNth.fic --output=hamnth.c   (n is the constant `target`)
{-
   A number is kept as its exponent triple (i, j, k). Triples are ordered by the logarithm i*ln 2 + j*ln 3 + k*ln 5 in Float
   (the logarithms are literals, so Elm under JavaScript and C built with -ffp-contract=off compute the same bits). The queue of
   the triples found so far is a flat Vector of records; the three pointers (for the factors 2, 3 and 5) only move forward, so
   the front of the queue that the smallest pointer has passed is cut off (Vector.slice) when it is as long as the rest:
   memory stays at the window of numbers between x / 5 and x, about 2.5 million at the billionth.
   The number itself is printed only at the end, as decimal digits, by multiplying a base 1e9 digit vector (no BigInt library):
   the multipliers are at most 2^22, 3^13 and 5^9, so that every product stays below 2^53 and Elm under JavaScript is exact too.
   Known values: the 1691st is 2125764000; the 1000000th has 84 digits.
-}


module Main exposing (main)

import BigInt
import Vector exposing (Vector)


target : Int
target =
    1000000


type alias Trip =
    { i : Int, j : Int, k : Int }


ln2 : Float
ln2 =
    0.6931471805599453


ln3 : Float
ln3 =
    1.0986122886681098


ln5 : Float
ln5 =
    1.6094379124341003


key : Trip -> Float
key t =
    toFloat t.i * ln2 + toFloat t.j * ln3 + toFloat t.k * ln5


same : Trip -> Trip -> Bool
same a b =
    a.i == b.i && a.j == b.j && a.k == b.k


zero : Trip
zero =
    { i = 0, j = 0, k = 0 }


at : Int -> Vector Trip -> Trip
at ix q =
    case Vector.get ix q of
        Just t ->
            t

        Nothing ->
            zero


{-| cut off the part of the queue in front of the smallest pointer when it is at least 65536 long and as long as the rest -}
trim : Int -> Int -> Vector Trip -> ( Int, Vector Trip )
trim base p5 q =
    let
        dead =
            p5 - base
    in
    if dead >= 65536 && dead * 2 >= Vector.length q then
        ( p5, Vector.slice dead (Vector.length q) q )

    else
        ( base, q )


{-| count = the number of triples found so far (base + length of q); the numbers are emitted in increasing order -}
loop : Int -> Vector Trip -> Int -> Int -> Int -> Int -> Trip
loop count q base p2 p3 p5 =
    if count >= target then
        at (count - 1 - base) q

    else
        let
            a =
                at (p2 - base) q

            b =
                at (p3 - base) q

            c =
                at (p5 - base) q

            ca =
                { i = a.i + 1, j = a.j, k = a.k }

            cb =
                { i = b.i, j = b.j + 1, k = b.k }

            cc =
                { i = c.i, j = c.j, k = c.k + 1 }

            ka =
                key ca

            kb =
                key cb

            kc =
                key cc

            next =
                if ka <= kb && ka <= kc then
                    ca

                else if kb <= kc then
                    cb

                else
                    cc

            p2n =
                if same ca next then
                    p2 + 1

                else
                    p2

            p3n =
                if same cb next then
                    p3 + 1

                else
                    p3

            p5n =
                if same cc next then
                    p5 + 1

                else
                    p5

            ( base2, q2 ) =
                trim base p5n (Vector.push next q)
        in
        loop (count + 1) q2 base2 p2n p3n p5n


-- the decimal digits: 2^i 3^j 5^k with the BigInt package


render : Trip -> String
render t =
    BigInt.toString
        (BigInt.mul
            (BigInt.mul (BigInt.pow (BigInt.fromInt 2) (BigInt.fromInt t.i)) (BigInt.pow (BigInt.fromInt 3) (BigInt.fromInt t.j)))
            (BigInt.pow (BigInt.fromInt 5) (BigInt.fromInt t.k))
        )


main : Program () () ()
main =
    Platform.worker
        { init =
            \_ ->
                let
                    t =
                        loop 1 (Vector.singleton zero) 0 0 0 0

                    s =
                        render t

                    _ =
                        Debug.log
                            ("Hamming number " ++ String.fromInt target ++ " = 2^" ++ String.fromInt t.i ++ " * 3^" ++ String.fromInt t.j ++ " * 5^" ++ String.fromInt t.k)
                            ()

                    _ =
                        Debug.log (s ++ " (" ++ String.fromInt (String.length s) ++ " digits)") ()
                in
                ( (), Cmd.none )
        , update = \_ _ -> ( (), Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
