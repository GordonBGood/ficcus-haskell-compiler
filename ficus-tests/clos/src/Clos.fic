module Clos exposing (main)

-- S7 part 3 (Ficus.Mono.Twin): a closure object that nobody else holds gives its captured values to the call that consumes it.
-- Closures that capture lists, arrays, strings, records and other closures; called once (taken apart), twice (the first call must
-- leave the captured values in place), never (dropped), through a partial application, under- and over-applied, stored in a data
-- structure, and streams of thunks. The output must equal Elm's (expected/clos.out, Elm 0.19.3).

import Array exposing (Array)
import Dict exposing (Dict)


type Stream a
    = Cons a (() -> Stream a)


from : Int -> List Int -> Stream ( Int, List Int )
from n seen =
    Cons ( n, seen ) (\() -> from (n + 1) (n :: List.take 2 seen))


takeS : Int -> Stream a -> List a
takeS k s =
    case s of
        Cons h rest ->
            if k <= 0 then
                []

            else
                h :: takeS (k - 1) (rest ())


mapS : (a -> b) -> Stream a -> Stream b
mapS f s =
    case s of
        Cons h rest ->
            Cons (f h) (\() -> mapS f (rest ()))


zipS : Stream a -> Stream b -> Stream ( a, b )
zipS xs ys =
    case ( xs, ys ) of
        ( Cons x xr, Cons y yr ) ->
            Cons ( x, y ) (\() -> zipS (xr ()) (yr ()))


{-| a thunk called twice: the second stream starts from the same tail -}
twice : Stream a -> ( List a, List a )
twice s =
    case s of
        Cons _ rest ->
            ( takeS 3 (rest ()), takeS 2 (rest ()) )


put : Array Int -> Int -> Int -> Array Int
put a i v =
    Array.set i v a


putL : Array Int -> (Int -> Int -> Array Int)
putL a =
    \i v -> Array.set i (v + Array.length a) a


once : Int -> (Int -> Int -> Array Int) -> Array Int
once i f =
    f (modBy 5 i) i


fill : Int -> Int -> Array Int -> Array Int
fill i n a =
    if i >= n then
        a

    else
        fill (i + 1) n (once i (put a))


fillL : Int -> Int -> Array Int -> Array Int
fillL i n a =
    if i >= n then
        a

    else
        fillL (i + 1) n (once i (putL a))


{-| the closure is used twice: both results come from the same array -}
both : Array Int -> ( Array Int, Array Int )
both a =
    let
        f =
            putL a
    in
    ( f 0 100, f 1 200 )


greet : String -> List String -> (String -> String)
greet greeting names =
    \sep -> greeting ++ " " ++ String.join sep names


type alias Acc =
    { total : Int, names : List String }


adder : Acc -> (String -> Int -> Acc)
adder acc =
    \name n -> { total = acc.total + n, names = name :: acc.names }


compose : (a -> b) -> (b -> c) -> (a -> c)
compose f g =
    \x -> g (f x)


counterOf : Dict String Int -> (String -> Dict String Int)
counterOf d =
    \k -> Dict.update k (\v -> Just (Maybe.withDefault 0 v + 1)) d


countAll : List String -> Dict String Int -> Dict String Int
countAll ws d =
    case ws of
        [] ->
            d

        w :: rest ->
            countAll rest (counterOf d w)


add3 : List Int -> Int -> Int -> Int
add3 xs b c =
    List.sum xs + b + c


applyAll : List (Int -> Int) -> Int -> List Int
applyAll fs x =
    List.map (\f -> f x) fs


unused : List Int -> Int
unused xs =
    let
        f =
            \y -> List.length xs + y
    in
    if List.isEmpty xs then
        f 1

    else
        List.length xs


main : Program () () ()
main =
    Platform.worker
        { init =
            \_ ->
                let
                    _ =
                        Debug.log "stream" (takeS 6 (from 0 []))

                    _ =
                        Debug.log "mapS" (takeS 4 (mapS (\( n, seen ) -> n * 10 + List.length seen) (from 0 [])))

                    _ =
                        Debug.log "zipS" (takeS 3 (zipS (from 0 []) (mapS Tuple.first (from 10 [ 9 ]))))

                    _ =
                        Debug.log "twice" (twice (from 5 [ 1, 2, 3 ]))

                    _ =
                        Debug.log "fill" (Array.toList (fill 0 23 (Array.repeat 5 0)))

                    _ =
                        Debug.log "fillL" (Array.toList (fillL 0 23 (Array.repeat 5 0)))

                    base =
                        Array.fromList [ 1, 2, 3 ]

                    _ =
                        Debug.log "both" (Tuple.mapBoth Array.toList Array.toList (both base))

                    _ =
                        Debug.log "base after" (Array.toList base)

                    g =
                        greet "hello" [ "ann", "bob" ]

                    _ =
                        Debug.log "greet" ( g ", ", g " and " )

                    _ =
                        Debug.log "adder" (adder (adder { total = 1, names = [] } "x" 2) "y" 3)

                    inc =
                        compose (\x -> x :: [ 0 ]) List.sum

                    _ =
                        Debug.log "compose" ( inc 4, compose (compose inc String.fromInt) (\s -> s ++ "!") 7 )

                    _ =
                        Debug.log "count" (Dict.toList (countAll [ "a", "b", "a", "c", "a", "b" ] Dict.empty))

                    partial =
                        add3 [ 1, 2, 3 ]

                    _ =
                        Debug.log "partial" ( partial 10 20, (add3 [ 4 ] 1) 2, List.map (partial 1) [ 1, 2 ] )

                    _ =
                        Debug.log "applyAll" (applyAll [ add3 [ 1 ] 2, \x -> x * 2, partial 5 ] 7)

                    _ =
                        Debug.log "unused" ( unused [], unused [ 1, 2 ] )
                in
                ( (), Cmd.none )
        , update = \_ m -> ( m, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
