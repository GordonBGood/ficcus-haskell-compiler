module Main exposing (main)

-- Higher order code: compose, partial application, pipelines, closures stored in data, Church numerals, function tables, fix points,
-- continuation passing, function equality avoided, curry/uncurry, flip, on-the-fly combinators.

import Dict exposing (Dict)


type alias Handler =
    { name : String, run : Int -> Int, undo : Maybe (Int -> Int) }


type Op
    = Op String (Int -> Int -> Int)


compose3 : (c -> d) -> (b -> c) -> (a -> b) -> a -> d
compose3 f g h x =
    f (g (h x))


flipp : (a -> b -> c) -> b -> a -> c
flipp f b a =
    f a b


twice : (a -> a) -> a -> a
twice f =
    f << f


iterate : Int -> (a -> a) -> a -> a
iterate n f x =
    if n <= 0 then
        x

    else
        iterate (n - 1) f (f x)


curry3 : (( a, b, c ) -> d) -> a -> b -> c -> d
curry3 f a b c =
    f ( a, b, c )


adder : Int -> Int -> Int
adder n =
    \x -> x + n


counterFrom : Int -> List (() -> Int)
counterFrom start =
    List.map (\i -> \_ -> start + i * i) (List.range 1 5)


type alias Church =
    (Int -> Int) -> Int -> Int


zero : Church
zero _ x =
    x


succC : Church -> Church
succC n f x =
    f (n f x)


addC : Church -> Church -> Church
addC a b f x =
    a f (b f x)


mulC : Church -> Church -> Church
mulC a b f =
    a (b f)


toInt : Church -> Int
toInt n =
    n (\x -> x + 1) 0


fromInt : Int -> Church
fromInt n =
    if n == 0 then
        zero

    else
        succC (fromInt (n - 1))


fix : ((a -> b) -> a -> b) -> a -> b
fix f x =
    f (fix f) x


factStep : (Int -> Int) -> Int -> Int
factStep self n =
    if n <= 1 then
        1

    else
        n * self (n - 1)


cpsFib : Int -> (Int -> r) -> r
cpsFib n k =
    if n < 2 then
        k n

    else
        cpsFibStep n k


cpsFibStep : Int -> (Int -> r) -> r
cpsFibStep n k =
    cpsFib (n - 1) (\a -> cpsFib (n - 2) (\b -> k (a + b)))


pipeline : List (Int -> Int)
pipeline =
    [ (+) 1, (*) 3, (\x -> x - 4), modBy 17, negate, abs, adder 100, min 50, max 0 ]


ops : Dict String Op
ops =
    Dict.fromList [ ( "add", Op "+" (+) ), ( "sub", Op "-" (-) ), ( "mul", Op "*" (*) ), ( "pow", Op "^" (^) ), ( "max", Op "max" max ) ]


applyOp : String -> Int -> Int -> String
applyOp key a b =
    case Dict.get key ops of
        Just (Op sym f) ->
            String.fromInt a ++ " " ++ sym ++ " " ++ String.fromInt b ++ " = " ++ String.fromInt (f a b)

        Nothing ->
            "?"


handlers : List Handler
handlers =
    [ { name = "double", run = \x -> x * 2, undo = Just (\x -> x // 2) }
    , { name = "inc", run = (+) 1, undo = Just (\x -> x - 1) }
    , { name = "square", run = \x -> x * x, undo = Nothing }
    ]


runAll : Int -> List Handler -> ( Int, List String )
runAll start hs =
    List.foldl (\h ( v, log ) -> ( h.run v, (h.name ++ ":" ++ String.fromInt (h.run v)) :: log )) ( start, [] ) hs


undoAll : Int -> List Handler -> Result String Int
undoAll v hs =
    List.foldr
        (\h acc ->
            case ( acc, h.undo ) of
                ( Ok x, Just u ) ->
                    Ok (u x)

                ( Ok _, Nothing ) ->
                    Err ("cannot undo " ++ h.name)

                ( e, _ ) ->
                    e
        )
        (Ok v)
        hs


results : List ( String, String )
results =
    let
        three =
            fromInt 3

        four =
            fromInt 4
    in
    [ ( "compose3", String.fromInt (compose3 String.length String.reverse String.trim "  hello  ") )
    , ( "twice", Debug.toString ( twice ((+) 3) 10, twice (twice (\s -> s ++ "!")) "x", twice (List.map ((*) 2)) [ 1, 2 ] ) )
    , ( "iterate", Debug.toString (iterate 10 (\( a, b ) -> ( b, a + b )) ( 0, 1 )) )
    , ( "curry3", String.fromInt (curry3 (\( a, b, c ) -> a * b + c) 6 7 8) )
    , ( "partial", Debug.toString (List.map (adder 5) [ 1, 2, 3 ]) )
    , ( "closures", Debug.toString (List.map (\f -> f ()) (counterFrom 100)) )
    , ( "church", Debug.toString ( toInt (addC three four), toInt (mulC three four), toInt (mulC (addC three three) (succC four)) ) )
    , ( "fix", Debug.toString (List.map (fix factStep) [ 0, 1, 5, 10, 15 ]) )
    , ( "cps", Debug.toString ( cpsFib 14 identity, cpsFib 10 (\x -> [ x, x ]), cpsFib 5 String.fromInt ) )
    , ( "pipeline", Debug.toString (List.map (\x -> List.foldl (\f acc -> f acc) x pipeline) [ -50, 0, 7, 1000 ]) )
    , ( "pipeline <|", Debug.toString (List.foldl (<|) 5 (List.map (\f -> f) pipeline)) )
    , ( "ops", String.join "; " (List.map (\k -> applyOp k 7 3) [ "add", "sub", "mul", "pow", "max", "none" ]) )
    , ( "handlers", Debug.toString (runAll 3 handlers |> Tuple.mapSecond List.reverse) )
    , ( "undo", Debug.toString ( undoAll 10 (List.take 2 handlers), undoAll 10 handlers ) )
    , ( "flip", Debug.toString (List.map2 (flipp (-)) [ 1, 2, 3 ] [ 10, 20, 30 ]) )
    , ( "uncurry", Debug.toString (List.map (\( f, args ) -> f args) [ ( \( a, b ) -> a + b, ( 1, 2 ) ), ( \( a, b ) -> a * b, ( 3, 4 ) ) ]) )
    , ( "sections", Debug.toString (List.map (\f -> f 10) [ (-) 3, (\x -> x - 3), (//) 100, (\x -> x // 3), (^) 2, (\x -> x ^ 2) ]) )
    , ( "apL/apR", Debug.toString [ [ 1, 2, 3 ] |> List.map ((*) 2) |> List.sum, List.sum <| List.map ((*) 2) <| [ 1, 2, 3 ], (List.sum << List.map ((*) 2)) [ 1, 2, 3 ], (List.map ((*) 2) >> List.sum) [ 1, 2, 3 ] ] )
    , ( "tuple functions", Debug.toString (List.map (Tuple.mapBoth String.length negate) [ ( "ab", 1 ), ( "", -4 ) ]) )
    ]


main : Program () () ()
main =
    Platform.worker
        { init = \_ -> ( run results, Cmd.none )
        , update = \_ m -> ( m, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }


run : List ( String, String ) -> ()
run items =
    List.foldl (\( k, v ) _ -> always () (Debug.log k v)) () items
