module Main exposing (main)

-- Dict and Set API sweep with String, Int, tuple and Char keys; merge, partition, foldr order, update, equality, Debug.toString.

import Dict exposing (Dict)
import Set exposing (Set)


inventory : Dict String Int
inventory =
    Dict.fromList [ ( "apple", 5 ), ( "pear", 0 ), ( "fig", 12 ), ( "kiwi", 3 ), ( "Apple", 1 ), ( "", 9 ) ]


other : Dict String Int
other =
    Dict.fromList [ ( "fig", 100 ), ( "plum", 7 ), ( "kiwi", 3 ) ]


results : List ( String, String )
results =
    [ ( "toList", Debug.toString (Dict.toList inventory) )
    , ( "toString", Debug.toString inventory )
    , ( "empty toString", Debug.toString (Dict.empty |> Dict.insert 1 "a" |> Dict.remove 1) )
    , ( "get/member", Debug.toString ( Dict.get "fig" inventory, Dict.get "nope" inventory, Dict.member "" inventory ) )
    , ( "size", Debug.toString ( Dict.size inventory, Dict.isEmpty inventory, Dict.isEmpty Dict.empty ) )
    , ( "insert overwrite", Debug.toString (Dict.toList (Dict.insert "fig" 0 inventory) |> List.take 3) )
    , ( "update", Debug.toString (Dict.toList (inventory |> Dict.update "fig" (Maybe.map ((+) 1)) |> Dict.update "new" (\_ -> Just 1) |> Dict.update "pear" (\_ -> Nothing))) )
    , ( "map", Debug.toString (Dict.toList (Dict.map (\k v -> String.length k + v) inventory)) )
    , ( "filter", Debug.toString (Dict.keys (Dict.filter (\_ v -> v > 2) inventory)) )
    , ( "partition", Debug.toString (Dict.partition (\k _ -> String.length k > 3) inventory |> Tuple.mapBoth Dict.keys Dict.keys) )
    , ( "foldl/foldr", Debug.toString ( Dict.foldl (\k _ acc -> k :: acc) [] inventory, Dict.foldr (\k _ acc -> k :: acc) [] inventory ) )
    , ( "union/inter/diff", Debug.toString ( Dict.toList (Dict.union inventory other) |> List.map Tuple.second, Dict.keys (Dict.intersect inventory other), Dict.keys (Dict.diff inventory other) ) )
    , ( "merge", Debug.toString (Dict.merge (\k a acc -> ( k, a, 0 ) :: acc) (\k a b acc -> ( k, a, b ) :: acc) (\k b acc -> ( k, 0, b ) :: acc) inventory other [] |> List.reverse) )
    , ( "keys/values", Debug.toString ( Dict.keys other, Dict.values other ) )
    , ( "fromList dups", Debug.toString (Dict.toList (Dict.fromList [ ( 1, "a" ), ( 2, "b" ), ( 1, "c" ) ])) )
    , ( "tuple keys", Debug.toString (Dict.toList (Dict.fromList [ ( ( 2, "b" ), 1 ), ( ( 1, "z" ), 2 ), ( ( 2, "a" ), 3 ) ])) )
    , ( "char keys", Debug.toString (Dict.toList (List.foldl (\c d -> Dict.update c (\m -> Just (Maybe.withDefault 0 m + 1)) d) Dict.empty (String.toList "mississippi"))) )
    , ( "float keys", Debug.toString (Dict.toList (Dict.fromList [ ( 1.5, "a" ), ( -2, "b" ), ( 0, "c" ) ])) )
    , ( "list keys", Debug.toString (Dict.toList (Dict.fromList [ ( [ 1, 2 ], "a" ), ( [ 1 ], "b" ), ( [], "c" ) ])) )
    , ( "equality", Debug.toString ( inventory == Dict.fromList (List.reverse (Dict.toList inventory)), inventory == other, Dict.empty == Dict.remove 1 (Dict.singleton 1 'x') ) )
    , ( "dict of dict", Debug.toString (Dict.map (\_ d -> Dict.toList d) (Dict.fromList [ ( 1, Dict.singleton "a" 1 ), ( 2, Dict.empty ) ])) )
    , ( "dict of list", Debug.toString (Dict.toList (List.foldl (\w d -> Dict.update (String.length w) (\m -> Just (w :: Maybe.withDefault [] m)) d) Dict.empty (String.words "a bb cc d eee ff"))) )
    , ( "many", Debug.toString (let d = List.foldl (\i acc -> Dict.insert (modBy 997 (i * 31)) i acc) Dict.empty (List.range 1 5000) in [ Dict.size d, Dict.foldl (\_ v s -> s + v) 0 d, Maybe.withDefault -1 (Dict.get 0 d), Maybe.withDefault -1 (Dict.get 996 d) ]) )
    , ( "remove many", Debug.toString (Dict.size (List.foldl Dict.remove (Dict.fromList (List.map (\i -> ( i, i )) (List.range 1 2000))) (List.filter (\i -> modBy 3 i /= 0) (List.range 1 2000)))) )
    , ( "set basics", Debug.toString ( Set.toList (Set.fromList [ 3, 1, 3, 2 ]), Set.member 2 (Set.fromList [ 1, 2 ]), Set.size (Set.fromList (String.toList "hello")) ) )
    , ( "set ops", Debug.toString (let a = Set.fromList [ 1, 2, 3, 4 ]
                                       b = Set.fromList [ 3, 4, 5 ] in ( Set.toList (Set.union a b), Set.toList (Set.intersect a b), Set.toList (Set.diff a b) )) )
    , ( "set map/filter", Debug.toString ( Set.toList (Set.map (\x -> modBy 3 x) (Set.fromList (List.range 1 10))), Set.toList (Set.filter (\x -> x > 2) (Set.fromList [ 1, 2, 3, 4 ])), Set.partition even (Set.fromList [ 1, 2, 3, 4 ]) |> Tuple.mapBoth Set.toList Set.toList ) )
    , ( "set fold", Debug.toString ( Set.foldl (::) [] (Set.fromList [ 2, 1, 3 ]), Set.foldr (::) [] (Set.fromList [ 2, 1, 3 ]) ) )
    , ( "set toString", Debug.toString (Set.fromList [ "b", "a" ]) ++ Debug.toString (Set.empty |> Set.insert 'x') ++ Debug.toString (Set.fromList [ ( 1, 'a' ) ]) )
    , ( "set eq", Debug.toString ( Set.fromList [ 1, 2 ] == Set.fromList [ 2, 1, 1 ], Set.fromList [ 1 ] == Set.empty ) )
    ]


even : Int -> Bool
even n =
    modBy 2 n == 0


main : Program () () ()
main =
    Platform.worker
        { init = \_ -> ( run results, Cmd.none )
        , update = \_ m -> ( m, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }


run : List ( String, String ) -> ()
run items =
    List.foldl (\( k, v ) _ -> always () (Debug.log k v)) () items
