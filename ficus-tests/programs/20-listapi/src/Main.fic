module Main exposing (main)

-- A sweep of the List, Maybe and Tuple APIs with edge cases (empty lists, negative arguments), plus patterns (as, nested, literals).

type Color
    = Red
    | Green
    | Blue


classify : List Int -> String
classify xs =
    case xs of
        [] ->
            "empty"

        [ 0 ] ->
            "zero"

        [ _ ] ->
            "one"

        [ a, b ] ->
            if a == b then "pair-equal" else "pair"

        (a :: ((b :: _) as rest)) ->
            "long " ++ String.fromInt (a + b) ++ " " ++ String.fromInt (List.length rest)


describe : ( Maybe Int, Result String Color ) -> String
describe pair =
    case pair of
        ( Just 0, _ ) ->
            "just zero"

        ( Just n, Ok Red ) ->
            "red " ++ String.fromInt n

        ( Nothing, Ok c ) ->
            "color " ++ Debug.toString c

        ( _, Err "bad" ) ->
            "err bad"

        _ ->
            "other"


strCase : String -> Int
strCase s =
    case s of
        "one" ->
            1

        "two" ->
            2

        "" ->
            0

        _ ->
            -1


charCase : Char -> String
charCase c =
    case c of
        'a' ->
            "A"

        '\n' ->
            "NL"

        '\u{00E9}' ->
            "e-acute"

        _ ->
            "?"


results : List ( String, String )
results =
    let
        xs =
            [ 3, 1, 4, 1, 5, 9, 2, 6 ]
    in
    [ ( "head/tail", String.join " " [ Debug.toString ( List.head xs ), Debug.toString ( List.tail xs ), Debug.toString ( List.head [] ), Debug.toString ( List.tail [ 1 ] ) ] )
    , ( "take/drop", String.join " " [ Debug.toString ( List.take 3 xs ), Debug.toString ( List.drop 6 xs ), Debug.toString ( List.take -1 xs ), Debug.toString ( List.drop -1 xs ), Debug.toString ( List.take 100 xs ) ] )
    , ( "reverse/append", Debug.toString ( List.reverse xs, xs ++ [ 0 ], List.append [] [ 1 ] ) )
    , ( "map2..5", String.join " " [ Debug.toString ( List.map2 (+) xs [ 10, 20 ] ), Debug.toString ( List.map3 (\a b c -> a + b + c) [ 1, 2 ] [ 10, 20 ] [ 100, 200, 300 ] ), Debug.toString ( List.map4 (\a b c d -> [ a, b, c, d ]) [ 1 ] [ 2 ] [ 3 ] [ 4 ] ), Debug.toString ( List.map5 (\a b c d e -> a + b + c + d + e) [ 1 ] [ 2 ] [ 3 ] [ 4 ] [ 5 ] ) ] )
    , ( "filterMap", Debug.toString (List.filterMap (\x -> if x > 3 then Just (x * x) else Nothing) xs) )
    , ( "concat", String.join " " [ Debug.toString ( List.concat [ [ 1 ], [], [ 2, 3 ] ] ), Debug.toString ( List.concatMap (\x -> [ x, x ]) [ 1, 2 ] ), Debug.toString ( List.intersperse 0 [ 1, 2, 3 ] ), Debug.toString ( List.intersperse 0 [] ) ] )
    , ( "partition", Debug.toString (List.partition (\x -> x > 3) xs) )
    , ( "unzip", Debug.toString (List.unzip [ ( 1, 'a' ), ( 2, 'b' ) ]) )
    , ( "range", String.join " " [ Debug.toString ( List.range 3 6 ), Debug.toString ( List.range 6 3 ), Debug.toString ( List.range -2 2 ), Debug.toString ( List.range 5 5 ) ] )
    , ( "repeat", Debug.toString ( List.repeat 3 "x", List.repeat 0 1, List.repeat -2 1 ) )
    , ( "member", Debug.toString ( List.member 9 xs, List.member 7 xs, List.member "a" [] ) )
    , ( "any/all", String.join " " [ Debug.toString ( List.any ((<) 8) xs ), Debug.toString ( List.all ((>) 10) xs ), Debug.toString ( List.all ((>) 0) [] ), Debug.toString ( List.any ((>) 0) [] ) ] )
    , ( "sum/product", String.join " " [ Debug.toString ( List.sum xs ), Debug.toString ( List.product xs ), Debug.toString ( List.sum [] ), Debug.toString ( List.product [] ), Debug.toString ( List.sum [ 0.5, 0.25 ] ) ] )
    , ( "foldl/foldr", String.join " " [ Debug.toString ( List.foldl (::) [] xs ), Debug.toString ( List.foldr (::) [] xs ), Debug.toString ( List.foldl (-) 0 xs ), Debug.toString ( List.foldr (-) 0 xs ) ] )
    , ( "scanl", Debug.toString (List.foldl (\x acc -> (x + Maybe.withDefault 0 (List.head acc)) :: acc) [] xs |> List.reverse) )
    , ( "indexedMap", Debug.toString (List.indexedMap (\i x -> i * x) xs) )
    , ( "sortBy/length", String.join " " [ Debug.toString ( List.sortBy negate xs ), Debug.toString ( List.length xs ), Debug.toString ( List.isEmpty xs ), Debug.toString ( List.isEmpty [] ) ] )
    , ( "singleton/last", Debug.toString ( List.singleton 1, List.head (List.reverse xs) ) )
    , ( "cons nest", Debug.toString (1 :: 2 :: [ 3 ] ++ 4 :: []) )
    , ( "classify", Debug.toString (List.map classify [ [], [ 0 ], [ 5 ], [ 2, 2 ], [ 1, 2 ], [ 1, 2, 3, 4 ] ]) )
    , ( "describe", Debug.toString (List.map describe [ ( Just 0, Ok Blue ), ( Just 3, Ok Red ), ( Nothing, Ok Green ), ( Just 1, Err "bad" ), ( Just 1, Err "" ), ( Just 2, Ok Blue ) ]) )
    , ( "string case", Debug.toString (List.map strCase [ "one", "two", "", "three" ]) )
    , ( "char case", Debug.toString (List.map charCase [ 'a', '\n', 'é', 'z' ]) )
    , ( "maybe", String.join " " [ Debug.toString ( Maybe.map ((+) 1) (Just 1) ), Debug.toString ( Maybe.andThen (\x -> if x > 0 then Just x else Nothing) (Just -1) ), Debug.toString ( Maybe.withDefault 0 Nothing ), Debug.toString ( Maybe.map2 (+) (Just 1) (Just 2) ) ] )
    , ( "maybe3", Debug.toString ( Maybe.map3 (\a b c -> a + b + c) (Just 1) (Just 2) Nothing, Maybe.map2 Tuple.pair (Just "a") (Just 'b') ) )
    , ( "tuple", String.join " " [ Debug.toString ( Tuple.first ( 1, 2 ) ), Debug.toString ( Tuple.second ( 1, 2 ) ), Debug.toString ( Tuple.mapFirst String.fromInt ( 1, 2 ) ), Debug.toString ( Tuple.mapSecond ((*) 2) ( 1, 2 ) ), Debug.toString ( Tuple.pair 1 2 ) ] )
    , ( "color order", Debug.toString ( Red, [ Blue, Green ], compare 1 2 ) )
    , ( "nested maybe", Debug.toString ( Just (Just Nothing), Just (Err "x" |> Result.mapError String.length), [ Just -1 ] ) )
    ]


main : Program () () ()
main =
    Platform.worker
        { init = \_ -> ( run results, Cmd.none )
        , update = \_ m -> ( m, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }


run : List ( String, String ) -> ()
run items =
    List.foldl (\( k, v ) _ -> always () (Debug.log k v)) () items
