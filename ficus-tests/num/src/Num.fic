module Num exposing (main)

-- Slice 2: `number` clones and polymorphic values. `limit` and `bigger` are polymorphic values used at
-- Int and at Float (clones limit__i64, limit__f64, ...); `addLimit` is a number function at both.


limit : number
limit =
    100


bigger : number
bigger =
    limit + limit


addLimit : number -> number
addLimit x =
    x + limit


scaled : number -> number
scaled x =
    x * bigger - x


-- a local function with a variable of the enclosing definition (n, through f > n) and a variable of its own
-- (cnt): `go` is cloned per clone of combine and per instance of cnt (outer: and key: of the .mono)
combine : number -> ()
combine n =
    let
        go f cnt =
            if f > n then
                cnt

            else
                go (f * 2) (cnt + 1)

        _ =
            Debug.log "go int" (go 1 0)

        _ =
            Debug.log "go float" (go 1 0.5)
    in
    ()


intResult : Int
intResult =
    addLimit 5 + scaled 3


floatResult : Float
floatResult =
    addLimit 0.5 + scaled 1.5


main : Program () () ()
main =
    Platform.worker
        { init =
            \_ ->
                let
                    _ =
                        Debug.log "limit int" (limit + 0)

                    _ =
                        Debug.log "limit float" (limit + 0.5)

                    _ =
                        Debug.log "bigger float" (bigger / 8)

                    _ =
                        Debug.log "int" intResult

                    _ =
                        Debug.log "float" floatResult

                    _ =
                        Debug.log "combine int" (combine 1000)

                    _ =
                        Debug.log "combine float" (combine 100.5)

                    _ =
                        Debug.log "add" ((+) 1 2)

                    _ =
                        Debug.log "addf" ((+) 1.25 2)
                in
                ( (), Cmd.none )
        , update = \_ _ -> ( (), Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
