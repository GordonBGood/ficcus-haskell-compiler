module Initlazy exposing (main)

-- A cycle of top-level values through a lambda (the `lazy` of parser combinators). `value` is a closure that mentions
-- `arr` only inside its lambda; `arr` uses `value` directly when it is initialised. A reference to a top-level value from
-- inside a lambda is resolved when the lambda is called, as in Elm's JS output (decision FIX2). Two cycles, so that the
-- source order, the name order and the use order differ. The output must equal Elm's (expected/initlazy.out, Elm 0.19.3 under node).


type alias P =
    List Int -> Int


lazy : (() -> P) -> P
lazy thunk =
    \xs -> thunk () xs


wrap : P -> P
wrap p =
    \xs -> 1 + p xs


alt : P -> P -> P
alt a b =
    \xs ->
        case xs of
            [] ->
                0

            x :: rest ->
                if x > 0 then
                    a rest

                else
                    b rest



-- cycle 1: arr is declared first and needs value at once; value needs arr (inside a lambda)


arr : P
arr =
    wrap value


value : P
value =
    lazy (\_ -> alt arr leaf)


leaf : P
leaf _ =
    100



-- cycle 2: three values, the use in the middle


zc : P
zc =
    wrap za


za : P
za =
    lazy (\_ -> alt zb leaf)


zb : P
zb =
    wrap (lazy (\_ -> alt zc za))



main : Program () () ()
main =
    Platform.worker
        { init =
            \_ ->
                let
                    l1 =
                        Debug.log "value" (List.map value [ [], [ 1 ], [ 1, 1 ], [ 1, 1, 0 ], [ 1, 0 ] ])

                    l2 =
                        Debug.log "za" (List.map za [ [], [ 1 ], [ 0, 1, 1 ], [ 0, 0, 1, 1 ] ])
                in
                if List.length [ l1, l2 ] > 0 then
                    ( (), Cmd.none )

                else
                    ( (), Cmd.none )
        , update = \_ m -> ( m, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
