module T1aWithin exposing (main)

-- T1a-2: receiveWithin: a message before the time (Just, the timer cancelled), the time first (Nothing), a long wait cut short by a
-- message, a message already queued (Just at once, no timer); a process killed while it waits never wakes. Needs FIC_TIME.

import Concurrent exposing (Exit(..), Mailbox)
import Process
import Task exposing (Task)


say : String -> a -> Task x a
say label v =
    Task.succeed () |> Task.map (\_ -> Debug.log label v)


worker : Mailbox Int -> Task Never (List (Maybe Int))
worker box =
    Concurrent.receiveWithin 50 box
        |> Task.andThen (say "w")
        |> Task.andThen (\a -> Concurrent.receiveWithin 50 box |> Task.andThen (say "w") |> Task.map (\b -> [ a, b ]))
        |> Task.andThen (\l -> Concurrent.receiveWithin 1000 box |> Task.andThen (say "w") |> Task.map (\c -> l ++ [ c ]))
        |> Task.andThen (\l -> Concurrent.receiveWithin 5 box |> Task.andThen (say "w") |> Task.map (\d -> l ++ [ d ]))


killee : Mailbox Int -> Task Never (List (Maybe Int))
killee box =
    Concurrent.receiveWithin 30 box |> Task.andThen (say "killee woke (never)") |> Task.map List.singleton


parent : Task Never ( Exit Never (List (Maybe Int)), Exit Never (List (Maybe Int)) )
parent =
    Concurrent.spawnWith worker
        |> Task.andThen
            (\w ->
                Concurrent.spawnWith killee
                    |> Task.andThen
                        (\k ->
                            Process.sleep 10
                                |> Task.andThen (\_ -> Concurrent.send (Concurrent.address w) 1)
                                |> Task.andThen (\_ -> Concurrent.kill k)
                                |> Task.andThen (\_ -> Process.sleep 100)
                                |> Task.andThen (\_ -> Concurrent.send (Concurrent.address w) 2)
                                |> Task.andThen (\_ -> Concurrent.send (Concurrent.address w) 3)
                                |> Task.andThen (\_ -> Concurrent.await w)
                                |> Task.andThen (\ew -> Concurrent.await k |> Task.map (\ek -> ( ew, ek )))
                        )
            )


type Msg
    = Got ( Exit Never (List (Maybe Int)), Exit Never (List (Maybe Int)) )


update : Msg -> Int -> ( Int, Cmd Msg )
update msg n =
    case Debug.log "update" msg of
        Got _ ->
            ( n + 1, Cmd.none )


main : Program () Int Msg
main =
    Platform.worker
        { init = \_ -> ( 0, Task.perform Got parent )
        , update = update
        , subscriptions = \_ -> Sub.none
        }
