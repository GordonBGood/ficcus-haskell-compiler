port module FicPortJs exposing (main)

-- E3c (D6): the JavaScript build of a .fic program with a Ficus payload is refused: there is no overlay module Int8 in a build to
-- JavaScript

import Int8 exposing (Int8)


port p : Int8 -> Cmd msg


main : Program () () ()
main =
    Platform.worker { init = \_ -> ( (), p (Int8.fromInt 1) ), update = \_ m -> ( m, Cmd.none ), subscriptions = \_ -> Sub.none }
