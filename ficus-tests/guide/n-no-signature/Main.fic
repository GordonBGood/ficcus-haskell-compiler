module Main exposing (main)


type Money
    = Money Int
    where
        add : Money -> Money -> Money
        add (Money a) (Money b) =
            Money (a + b)


twice x =
    Money.add x x


report : () -> ()
report _ =
    Debug.log "r" (twice (Money 2)) |> always ()


main : Program () () ()
main =
    Platform.worker
        { init = \_ -> ( report (), Cmd.none )
        , update = \_ m -> ( m, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
