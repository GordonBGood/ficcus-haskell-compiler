module Main exposing (main)


type Money
    = Money Int
    where
        zero : Money
        zero =
            Money 0

        add : Money -> Money -> Money
        add (Money a) (Money b) =
            Money (a + b)


sum : List a -> a
    where
        a has zero : a
        a has add : a -> a -> a
sum xs =
    List.foldl add zero xs


report : () -> ()
report _ =
    Debug.log "r" (sum [ Money 1 ]) |> always ()


main : Program () () ()
main =
    Platform.worker
        { init = \_ -> ( report (), Cmd.none )
        , update = \_ m -> ( m, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
