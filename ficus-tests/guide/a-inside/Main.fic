module Main exposing (main)


type Money
    = Money Int
    where
        zero : Money
        zero =
            Money 0

        add : Money -> Money -> Money
        add (Money a) (Money b) =
            Money (a + b)

        -- inside the block the members are visible by their plain names
        sum : List Money -> Money
        sum ms =
            List.foldl add zero ms

        double : Money -> Money
        double m =
            add m m


add : Int -> Int -> Int
add a b =
    a * b


report : () -> ()
report _ =
    let
        _ =
            Debug.log "sum" (Money.sum [ Money 1, Money 2 ])

        _ =
            Debug.log "double" (Money.double (Money 21))

        _ =
            Debug.log "top level add" (add 3 4)
    in
    ()


main : Program () () ()
main =
    Platform.worker
        { init = \_ -> ( report (), Cmd.none )
        , update = \_ m -> ( m, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
