module X7Closure exposing (main)

import Array exposing (Array)
import Dict exposing (Dict)


type alias Model =
    { a : Array Int, d : Dict Int Int, n : Int }


type Msg
    = Step


initModel : Model
initModel =
    { a = Array.repeat 100 0, d = Dict.singleton 1 1, n = 1000 }


final : Model -> Model
final m =
    if m.n == 0 then
        Debug.log "final" { m | a = Array.slice 0 5 m.a }

    else
        m


update : Msg -> Model -> ( Model, Cmd Msg )
update =
    updateWith 2


updateWith : Int -> Msg -> Model -> ( Model, Cmd Msg )
updateWith k _ { a, d, n } =
    ( final { a = Array.set (modBy 100 n) (k * n) a, d = d, n = n - 1 }, Cmd.none )

main : Program () Model Msg
main =
    Platform.worker
        { init = \_ -> ( initModel, Cmd.none )
        , update = update
        , subscriptions = \_ -> Sub.none
        }
