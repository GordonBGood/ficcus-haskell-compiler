module Poly3a exposing (main)

-- Slice 3a: unconstrained variables keyed by class, constructors, case, lets and recursive groups, no function
-- values (no lambda or partial application is passed anywhere). Every output is compared with Elm.


-- a custom type: a heap object, a field at a variable position
type Box a
    = Box a


wrap : a -> Box a
wrap x =
    Box x


unbox : Box a -> a
unbox (Box v) =
    v


-- annotated self recursion: the group has one member, one clone per class of the element
count : List a -> Int
count xs =
    case xs of
        [] ->
            0

        _ :: rest ->
            1 + count rest


-- inferred mutual recursion: one group. (Elm 0.19.3 does not generalize an inferred recursive group, the Ficus
-- compiler does (D15), so the program below uses each group at one type: Elm must accept it for the reference output.)
evens xs =
    case xs of
        [] ->
            []

        x :: rest ->
            x :: odds rest


odds xs =
    case xs of
        [] ->
            []

        _ :: rest ->
            evens rest


-- an inferred group whose members have different variables: chase : List a -> b -> c, stop : b -> c
-- (`a` does not occur in the type of stop: dead there, keyed by ref)
chase xs y =
    case xs of
        [] ->
            stop y

        _ :: rest ->
            chase rest y


stop z =
    chase [] z


-- a tuple and a record at variable positions (boxed: ref)
pairUp : a -> b -> ( a, b )
pairUp a b =
    ( a, b )


-- polymorphic values used at two classes
none : Maybe a
none =
    Nothing


empty : List a
empty =
    []


noneInt : Maybe Int
noneInt =
    none


noneString : Maybe String
noneString =
    none


emptyInt : List Int
emptyInt =
    empty


emptyString : List String
emptyString =
    empty


isNothing : Maybe a -> Int
isNothing m =
    case m of
        Nothing ->
            1

        Just _ ->
            0


-- chase and stop never terminate when run (the group has no exit), so they are only reached behind a guard that
-- is never true; the specializer clones them all the same
guarded : String
guarded =
    if count [] > 0 then
        chase [ 1, 2, 3 ] "end"

    else
        "skipped"


guardedString : String
guardedString =
    if tally < 0 then
        stop "x"

    else
        "five"


-- a local group (polymorphic in its own variable) used outside at one type
tally : Int
tally =
    let
        ping xs =
            case xs of
                [] ->
                    0

                _ :: r ->
                    1 + pong r

        pong xs =
            case xs of
                [] ->
                    0

                _ :: r ->
                    2 + ping r
    in
    ping [ 10, 20, 30, 40, 50 ]


-- a non-recursive local polymorphic function used at two types
localTwo : String
localTwo =
    let
        dup x =
            ( x, x )

        first p =
            case p of
                ( a, _ ) ->
                    a
    in
    String.fromInt (first (dup 3)) ++ first (dup "s") ++ String.fromFloat (first (dup 2.5))


boxedPair : String
boxedPair =
    let
        p =
            pairUp ( 1, 2 ) { x = 3.5, y = 4.25 }
    in
    case p of
        ( ( a, b ), r ) ->
            String.fromInt (a + b) ++ " " ++ String.fromFloat (r.x + r.y)


-- a tuple and a record inside a Box and read back
boxes : String
boxes =
    let
        ( n, m ) =
            unbox (wrap ( 7, 8 ))

        r =
            unbox (wrap { name = "box", size = 2.5 })
    in
    String.fromInt (n * m) ++ " " ++ r.name ++ " " ++ String.fromFloat r.size


main : Program () () ()
main =
    Platform.worker
        { init =
            \_ ->
                let
                    _ =
                        Debug.log "unbox int" (unbox (wrap 41) + 1)

                    _ =
                        Debug.log "unbox float" (unbox (wrap 1.5) * 2)

                    _ =
                        Debug.log "unbox string" (unbox (wrap "boxed") ++ "!")

                    _ =
                        Debug.log "count int" (count [ 1, 2, 3 ])

                    _ =
                        Debug.log "count string" (count [ "a", "b" ])

                    _ =
                        Debug.log "count float" (count [ 0.5 ])

                    _ =
                        Debug.log "count pair" (count [ ( 1, 2 ), ( 3, 4 ) ])

                    _ =
                        Debug.log "evens" (count (evens [ 1, 2, 3, 4, 5 ]))

                    _ =
                        Debug.log "odds" (count (odds [ 6, 7, 8, 9 ]))

                    _ =
                        Debug.log "chase" guarded

                    _ =
                        Debug.log "stop" guardedString

                    _ =
                        Debug.log "none int" (isNothing noneInt + isNothing (Just 2))

                    _ =
                        Debug.log "none string" (isNothing noneString)

                    _ =
                        Debug.log "empty int" (count (1 :: emptyInt))

                    _ =
                        Debug.log "empty string" (count ("x" :: "y" :: emptyString))

                    _ =
                        Debug.log "tally" tally

                    _ =
                        Debug.log "local" localTwo

                    _ =
                        Debug.log "pair" boxedPair

                    _ =
                        Debug.log "boxes" boxes
                in
                ( (), Cmd.none )
        , update = \_ _ -> ( (), Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
