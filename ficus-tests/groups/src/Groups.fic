module Groups exposing (main)

-- Ficus only: an inferred recursive group used at two types, and chase/stop at different instances. Elm 0.19.3
-- rejects this program (it does not generalize an inferred group, the Ficus compiler does: D15), so the expected
-- output is written by hand and not taken from Elm.


evens xs =
    case xs of
        [] ->
            []

        x :: rest ->
            x :: odds rest


odds xs =
    case xs of
        [] ->
            []

        _ :: rest ->
            evens rest


count : List a -> Int
count xs =
    case xs of
        [] ->
            0

        _ :: rest ->
            1 + count rest


chase xs y =
    case xs of
        [] ->
            stop y

        _ :: rest ->
            chase rest y


stop z =
    if count [ z ] > 1 then
        chase [] z

    else
        z


main : Program () () ()
main =
    Platform.worker
        { init =
            \_ ->
                let
                    _ =
                        Debug.log "evens int" (count (evens [ 1, 2, 3, 4, 5 ]))

                    _ =
                        Debug.log "odds string" (count (odds [ "a", "b", "c", "d" ]))

                    _ =
                        Debug.log "evens float" (count (evens [ 0.5, 1.5 ]))

                    _ =
                        Debug.log "chase" (chase [ 1, 2, 3 ] "end")

                    _ =
                        Debug.log "stop" (stop 9)
                in
                ( (), Cmd.none )
        , update = \_ _ -> ( (), Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
