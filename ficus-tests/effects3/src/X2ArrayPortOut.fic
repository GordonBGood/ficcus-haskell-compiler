port module X2ArrayPortOut exposing (main)
-- E2 review Q6: an outgoing port of an Array payload (a compile error until E3a; since E3a it runs, compared with Elm by effects_e3.py).

import Array exposing (Array)

port outArr : Array Int -> Cmd msg


main : Program () Int ()
main =
    Platform.worker
        { init = \_ -> ( 0, outArr (Array.fromList [ 1, 2 ]) )
        , update = \_ n -> ( n, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
