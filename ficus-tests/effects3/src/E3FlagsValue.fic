module E3FlagsValue exposing (main)

-- E3b (D11): Json.Value flags (absent flags: Elm passes undefined in; Ficus refuses to start, a recorded deviation)

import Json.Encode as E


main : Program E.Value () ()
main =
    Platform.worker
        { init = \v -> ( Debug.log "flags" (E.encode 0 v) |> always (), Cmd.none )
        , update = \_ m -> ( m, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
