port module X3ArrayPortIn exposing (main)
-- E2 review Q6: an incoming port of a record with an Array field (a compile error until E3a; since E3a it runs, compared with Elm by effects_e3.py).

import Array exposing (Array)

port inArr : ({ xs : Array Int } -> msg) -> Sub msg


main : Program () Int ()
main =
    Platform.worker
        { init = \_ -> ( 0, Cmd.none )
        , update = \_ n -> ( n, Cmd.none )
        , subscriptions = \_ -> inArr (\_ -> ())
        }
