module X1FlagsString exposing (main)
-- E2 review Q6: a worker with String flags (a compile error from the E2 review until E3b; since E3b it runs, compared with Elm by effects_e3.py).




main : Program String Int ()
main =
    Platform.worker
        { init = \f -> ( String.length (Debug.log "flags" f), Cmd.none )
        , update = \_ n -> ( n, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
