port module E3FlagsListNested exposing (main)

-- E3a review F1: List (List Int) flags; the decoder builds the cons cell of the inner List Int (fic_o_ip). The program only counts the elements:
-- code that reads an element (or Debug.toString) would declare that cell itself and hide the fault.


port out : Int -> Cmd msg


main : Program (List (List Int)) () ()
main =
    Platform.worker
        { init = \f -> ( (), out (List.length f) )
        , update = \_ m -> ( m, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
