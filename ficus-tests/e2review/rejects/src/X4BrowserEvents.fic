module X4BrowserEvents exposing (main)
-- E2 review Q4: Browser.Events (an effect manager of elm/browser) in a worker: Elm runs it (no events under node); Ficus must
-- stop with a clear compile error until elm/browser's managers are supported.

import Browser.Events




main : Program () Int ()
main =
    Platform.worker
        { init = \_ -> ( 0, Cmd.none )
        , update = \_ n -> ( n, Cmd.none )
        , subscriptions = \_ -> Browser.Events.onResize (\_ _ -> ())
        }
