port module R6Maps exposing (main)

-- E2 review Q2 and Q3: Cmd.map and Sub.map nodes, nested, over Task, Random, Time and both kinds of port, at many class pairs (Int,
-- Float, String, record, tuple, unit, Bool, enum, custom type, list), with taggers that Debug.log: the order and the count of tagger
-- calls must equal Elm's (Elm composes the taggers and calls the manager's map once; Ficus maps one node at a time).

import Process
import Random
import Task
import Time


port out : Int -> Cmd msg


port inn : (String -> msg) -> Sub msg


type Color
    = Red
    | Green


type Inner
    = IA Int
    | IB String
    | IC Color


type Msg
    = Outer Inner
    | Flt Float
    | Rec { k : Int, s : String }
    | Tup ( Int, Bool )
    | Unit ()
    | Lst (List Int)
    | Wrap Msg
    | Tick Int


tag : String -> (a -> b) -> a -> b
tag name f x =
    let
        _ =
            Debug.log ("tagger " ++ name) x
    in
    f x


cmds : Cmd Msg
cmds =
    Cmd.batch
        [ Cmd.map (tag "o1" Outer) (Cmd.map (tag "i1" IA) (Task.perform identity (Task.succeed 5)))
        , Cmd.map (tag "o2" Outer)
            (Cmd.batch
                [ Cmd.map (tag "i2" IB) (Random.generate identity (Random.uniform "x" [ "y", "z" ]))
                , Cmd.map (tag "i3" IA) (Random.generate identity (Random.int 1 1000))
                , Cmd.map (tag "i4" IC) (Task.perform identity (Task.succeed Green))
                ]
            )
        , Cmd.map (tag "f" Flt) (Task.perform toFloat (Task.succeed 3))
        , Cmd.map (tag "r" Rec) (Task.perform identity (Task.succeed { k = 1, s = "a" }))
        , Cmd.map (tag "t" Tup) (Task.perform identity (Task.succeed ( 2, True )))
        , Cmd.map (tag "u" Unit) (Task.perform identity (Task.succeed ()))
        , Cmd.map (tag "l" Lst) (Random.generate identity (Random.list 3 (Random.int 0 9)))
        , Cmd.map (tag "p" Wrap) (out 7)
        , Cmd.map (tag "none" Wrap) (Cmd.map (tag "none2" Flt) Cmd.none)
        , Cmd.map (tag "w1" Wrap) (Cmd.map (tag "w2" Wrap) (Cmd.map (tag "w3" Flt) (Task.perform (\_ -> 1.5) (Process.sleep 1))))
        ]


update : Msg -> Int -> ( Int, Cmd Msg )
update msg n =
    let
        _ =
            Debug.log "update" msg
    in
    case msg of
        Outer (IB s) ->
            ( n + 1, Cmd.map (tag "again" Wrap) (Cmd.map (tag "again2" Outer) (Task.perform IB (Task.succeed (s ++ "!")))) )

        Wrap (Tick _) ->
            ( n + 100, Cmd.none )

        _ ->
            ( n + 1, Cmd.none )


subscriptions : Int -> Sub Msg
subscriptions n =
    Sub.batch
        [ Sub.map (tag "so" Outer) (Sub.map (tag "si" IB) (inn identity))
        , Sub.map (tag "sw" Wrap) (inn (\s -> Outer (IB ("direct " ++ s))))
        , if n < 300 then
            Sub.map (tag "time" Wrap) (Time.every 30 (\_ -> Tick n))

          else
            Sub.none
        ]


main : Program () Int Msg
main =
    Platform.worker
        { init = \_ -> ( 0, cmds )
        , update = update
        , subscriptions = subscriptions
        }
