-- IN ELM


minValue : Int8
minValue =
    fromInt -128


maxValue : Int8
maxValue =
    fromInt 127


{-| The number in a text of decimal digits with an optional sign; `Nothing` when the text is not one or the number does not fit (it does not wrap around).
-}
fromString : String -> Maybe Int8
fromString s =
    case String.toInt s of
        Just n ->
            if n >= -128 && n <= 127 then
                Just (fromInt n)

            else
                Nothing

        Nothing ->
            Nothing

