-- IN ELM


minValue : Int32
minValue =
    fromInt -2147483648


maxValue : Int32
maxValue =
    fromInt 2147483647


{-| The number in a text of decimal digits with an optional sign; `Nothing` when the text is not one or the number does not fit (it does not wrap around).
-}
fromString : String -> Maybe Int32
fromString s =
    case String.toInt s of
        Just n ->
            if n >= -2147483648 && n <= 2147483647 then
                Just (fromInt n)

            else
                Nothing

        Nothing ->
            Nothing

