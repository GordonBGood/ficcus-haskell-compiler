-- IN ELM


minValue : Word64
minValue =
    fromInt 0


maxValue : Word64
maxValue =
    fromInt -1


{-| The number in a text of decimal digits; `Nothing` when the text is not one or the number does not fit (it does not wrap around).
-}
fromString : String -> Maybe Word64
fromString s =
    if String.isEmpty s then
        Nothing

    else
        fromStringHelp (String.toList s) (fromInt 0)


fromStringHelp : List Char -> Word64 -> Maybe Word64
fromStringHelp chars acc =
    case chars of
        [] ->
            Just acc

        c :: rest ->
            let
                d =
                    Char.toCode c - 48
            in
            if d < 0 || d > 9 then
                Nothing

            else if acc > fromInt 1844674407370955161 || (acc == fromInt 1844674407370955161 && d > 5) then
                Nothing

            else
                fromStringHelp rest (acc * fromInt 10 + fromInt d)

