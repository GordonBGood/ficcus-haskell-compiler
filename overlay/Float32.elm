    ( Float32(..)
    , fromInt, fromFloat, toFloat, toString, fromString
    )

{-| Ficus (generated by ficus-tools/gen_sized.py, do not edit; docs/SIZED-PLAN.md): the 32 bit floating point number `Float32`. Every result is rounded to a float (the value is held in a double that is exactly a float), printed with the shortest digits that read back as the same float. `Float32.fromFloat` rounds, `toFloat` is exact.

The operators, comparisons, `Dict` keys and `List.sort` work through the members below (decision A3); the specializer replaces every
member and every function marked (kernel) by the C operation of runtime/fic_sized.h, so the bodies only give the types (`zero` is the
literal 0 at the type, A5c). The module is
added to the source directories of `.c` and `.mono` builds (Ficus.Mono.Overlay); a module `Float32` of the project or of a package of the
same name wins over this one (Build.crawlModule). `Float32(..)` is exported so that the members are visible to the type checker.
-}

import Basics exposing (Float, Int, Order(..))
import Maybe exposing (Maybe(..))
import String exposing (String)


{-| The constructor is never built: it marks the type as the built-in one.
-}
type Float32
    = FicFloat32Builtin
    where
        zero : Float32
        zero =
            0

        add : Float32 -> Float32 -> Float32
        add a _ =
            a

        sub : Float32 -> Float32 -> Float32
        sub a _ =
            a

        mul : Float32 -> Float32 -> Float32
        mul a _ =
            a

        pow : Float32 -> Float32 -> Float32
        pow a _ =
            a

        neg : Float32 -> Float32
        neg a =
            a

        abs : Float32 -> Float32
        abs a =
            a

        fromInt : Int -> Float32
        fromInt _ =
            FicFloat32Builtin

        compare : Float32 -> Float32 -> Order
        compare _ _ =
            EQ

        div : Float32 -> Float32 -> Float32
        div a _ =
            a

        fromFloat : Float -> Float32
        fromFloat _ =
            FicFloat32Builtin


-- KERNEL FUNCTIONS (types only)


{-| (kernel) the `Int` rounded to a float
-}
fromInt : Int -> Float32
fromInt n =
    fromInt n


{-| (kernel) the `Float` rounded to a float (an overflow gives infinity)
-}
fromFloat : Float -> Float32
fromFloat x =
    fromFloat x


{-| (kernel) the same number as a `Float`
-}
toFloat : Float32 -> Float
toFloat a =
    toFloat a


{-| (kernel) the shortest decimal text that reads back as the same float
-}
toString : Float32 -> String
toString a =
    toString a


{-| `Nothing` when the text is not a number (as `String.toFloat`)
-}
fromString : String -> Maybe Float32
fromString s =
    case String.toFloat s of
        Just x ->
            Just (fromFloat x)

        Nothing ->
            Nothing
