-- IN ELM


minValue : Word32
minValue =
    fromInt 0


maxValue : Word32
maxValue =
    fromInt 4294967295


{-| The number in a text of decimal digits; `Nothing` when the text is not one or the number does not fit (it does not wrap around).
-}
fromString : String -> Maybe Word32
fromString s =
    case String.toInt s of
        Just n ->
            if n >= 0 && n >= 0 && n <= 4294967295 then
                Just (fromInt n)

            else
                Nothing

        Nothing ->
            Nothing

