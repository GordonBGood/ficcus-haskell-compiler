-- IN ELM


minValue : Word8
minValue =
    fromInt 0


maxValue : Word8
maxValue =
    fromInt 255


{-| The number in a text of decimal digits; `Nothing` when the text is not one or the number does not fit (it does not wrap around).
-}
fromString : String -> Maybe Word8
fromString s =
    case String.toInt s of
        Just n ->
            if n >= 0 && n >= 0 && n <= 255 then
                Just (fromInt n)

            else
                Nothing

        Nothing ->
            Nothing

