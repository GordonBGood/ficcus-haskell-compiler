-- IN ELM


minValue : Word16
minValue =
    fromInt 0


maxValue : Word16
maxValue =
    fromInt 65535


{-| The number in a text of decimal digits; `Nothing` when the text is not one or the number does not fit (it does not wrap around).
-}
fromString : String -> Maybe Word16
fromString s =
    case String.toInt s of
        Just n ->
            if n >= 0 && n >= 0 && n <= 65535 then
                Just (fromInt n)

            else
                Nothing

        Nothing ->
            Nothing

