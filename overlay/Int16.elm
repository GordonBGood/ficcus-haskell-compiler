-- IN ELM


minValue : Int16
minValue =
    fromInt -32768


maxValue : Int16
maxValue =
    fromInt 32767


{-| The number in a text of decimal digits with an optional sign; `Nothing` when the text is not one or the number does not fit (it does not wrap around).
-}
fromString : String -> Maybe Int16
fromString s =
    case String.toInt s of
        Just n ->
            if n >= -32768 && n <= 32767 then
                Just (fromInt n)

            else
                Nothing

        Nothing ->
            Nothing

