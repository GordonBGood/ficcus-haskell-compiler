-- Fannkuch-redux: the Computer Language Benchmarks Game program.
-- V1 sanity measurement (docs/STAGE4-V1.md): Fannkuch.elm with the flat Vector of Ficcus in place of Array, written against the
-- primitives of step V1 only (the reversal exchanges two elements with Vector.swap).
{-
   For every permutation of 1..n (generated by the benchmark's rotation scheme) count the
   "pancake flips" (reverse the first k elements, k being the first element, until the first
   element is 1 -- here the elements are 0 based, so until it is 0). The checksum adds the
   flip count for even permutation numbers and subtracts it for odd ones; the result also
   gives the maximum flip count. Only Int arithmetic and Vector get, set and swap are used.
   Published results: n = 7: 228 and 16; n = 10: 73196 and 38; n = 12: 3968050 and 65.
-}


module FannkuchVec exposing (main)

import Vector exposing (Vector)


size : Int
size =
    10


get : Int -> Vector Int -> Int
get i a =
    Vector.get i a |> Maybe.withDefault 0


{-| Reverse the elements 0 to k inclusive. -}
reverseTo : Int -> Int -> Vector Int -> Vector Int
reverseTo i j p =
    if i >= j then
        p

    else
        reverseTo (i + 1) (j - 1) (Vector.swap i j p)


flips : Int -> Vector Int -> Int
flips cnt p =
    let
        k =
            get 0 p
    in
    if k == 0 then
        cnt

    else
        flips (cnt + 1) (reverseTo 0 k p)


{-| Elements 1 to r move down one place, the first goes to place r. -}
rotate : Int -> Int -> Int -> Vector Int -> Vector Int
rotate i r p0 p =
    if i >= r then
        Vector.set r p0 p

    else
        rotate (i + 1) r p0 (Vector.set i (get (i + 1) p) p)


setCounts : Int -> Vector Int -> Vector Int
setCounts r count =
    if r == 1 then
        count

    else
        setCounts (r - 1) (Vector.set (r - 1) r count)


nextPerm : Int -> Vector Int -> Vector Int -> Maybe ( Vector Int, Vector Int, Int )
nextPerm r perm1 count =
    if r == size then
        Nothing

    else
        let
            rotated =
                rotate 0 r (get 0 perm1) perm1

            cr =
                get r count - 1

            count2 =
                Vector.set r cr count
        in
        if cr > 0 then
            Just ( rotated, count2, r )

        else
            nextPerm (r + 1) rotated count2


search : Int -> Vector Int -> Vector Int -> Int -> Int -> Int -> ( Int, Int )
search r perm1 count pc cs mx =
    let
        count2 =
            setCounts r count

        f =
            flips 0 perm1

        cs2 =
            if modBy 2 pc == 0 then
                cs + f

            else
                cs - f

        mx2 =
            max mx f
    in
    case nextPerm 1 perm1 count2 of
        Nothing ->
            ( cs2, mx2 )

        Just ( p, c, r2 ) ->
            search r2 p c (pc + 1) cs2 mx2


fannkuch : () -> ( Int, Int )
fannkuch () =
    search size (upTo 0 size (Vector.withCapacity size)) (zeros size (Vector.withCapacity size)) 0 0 0


upTo : Int -> Int -> Vector Int -> Vector Int
upTo i n v =
    if i >= n then
        v

    else
        upTo (i + 1) n (Vector.push i v)


zeros : Int -> Vector Int -> Vector Int
zeros n v =
    if n <= 0 then
        v

    else
        zeros (n - 1) (Vector.push 0 v)


tell : String -> ()
tell s =
    Debug.log s ()


main : Program () () ()
main =
    Platform.worker
        { init =
            \_ ->
                let
                    ( checksum, maxFlips ) =
                        fannkuch ()

                    _ =
                        tell (String.fromInt checksum)

                    _ =
                        tell ("Pfannkuchen(" ++ String.fromInt size ++ ") = " ++ String.fromInt maxFlips)
                in
                ( (), Cmd.none )
        , update = \_ _ -> ( (), Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
