module Main exposing (main)

import Vector exposing (Vector)


-- drop the first element, n times: a queue read from the front
dropFront : Int -> Vector Int -> Vector Int
dropFront n v =
    if n == 0 then
        v

    else
        dropFront (n - 1) (Vector.slice 1 (Vector.length v) v)


report : () -> ()
report _ =
    let
        v =
            dropFront 900 (Vector.initialize 1000 identity)
    in
    Debug.log "left" ( Vector.length v, Vector.get 0 v ) |> always ()


main : Program () () ()
main =
    Platform.worker
        { init = \_ -> ( report (), Cmd.none )
        , update = \_ m -> ( m, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
