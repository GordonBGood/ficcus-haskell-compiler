module Main exposing (main)


type T
    = T Int
    where
        zero : T
        zero =
            T 0

        add : T -> Int -> T
        add (T a) b =
            T (a + b)


sum : List a -> a
    where
        a has zero : a
        a has add : a -> a -> a
sum xs =
    List.foldl add zero xs


report : () -> ()
report _ =
    Debug.log "r" (sum [ T 1 ]) |> always ()


main : Program () () ()
main =
    Platform.worker
        { init = \_ -> ( report (), Cmd.none )
        , update = \_ m -> ( m, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
