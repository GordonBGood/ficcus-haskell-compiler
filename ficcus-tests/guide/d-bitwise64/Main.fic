module Main exposing (main)

import Bitwise64


-- `Bitwise64` is Ficcus only: the same seven functions on the full 64 bits
report : () -> ()
report _ =
    let
        _ =
            Debug.log "shiftLeftBy 40 1" (Bitwise64.shiftLeftBy 40 1)

        _ =
            Debug.log "shiftLeftBy 63 1" (Bitwise64.shiftLeftBy 63 1)

        _ =
            Debug.log "and 0xFFFFFFFF 0x1FFFFFFFF" (Bitwise64.and 0xFFFFFFFF 0x0001FFFFFFFF)

        _ =
            Debug.log "complement 0" (Bitwise64.complement 0)

        _ =
            Debug.log "shiftRightZfBy 0 -1" (Bitwise64.shiftRightZfBy 0 -1)

        _ =
            Debug.log "shiftRightZfBy 1 -1" (Bitwise64.shiftRightZfBy 1 -1)

        _ =
            Debug.log "shiftRightBy 1 -8" (Bitwise64.shiftRightBy 1 -8)

        _ =
            Debug.log "shiftLeftBy 64 1" (Bitwise64.shiftLeftBy 64 1)
    in
    ()


main : Program () () ()
main =
    Platform.worker
        { init = \_ -> ( report (), Cmd.none )
        , update = \_ m -> ( m, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
