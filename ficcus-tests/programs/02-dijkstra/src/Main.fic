module Main exposing (main)

-- Dijkstra with Set as priority queue, BFS on a grid with Dict/Set, connected components, topological sort.

import Dict exposing (Dict)
import Set exposing (Set)


type alias Graph =
    Dict Int (List ( Int, Int ))


mkGraph : List ( Int, Int, Int ) -> Graph
mkGraph edges =
    List.foldl
        (\( a, b, w ) g ->
            g
                |> Dict.update a (\m -> Just (( b, w ) :: Maybe.withDefault [] m))
                |> Dict.update b (\m -> Just (( a, w ) :: Maybe.withDefault [] m))
        )
        Dict.empty
        edges


dijkstra : Graph -> Int -> Dict Int Int
dijkstra g src =
    dijLoop g (Set.singleton ( 0, src )) (Dict.singleton src 0)


dijLoop : Graph -> Set ( Int, Int ) -> Dict Int Int -> Dict Int Int
dijLoop g queue dist =
    case Set.toList queue of
        [] ->
            dist

        ( d, u ) :: _ ->
            let
                q1 =
                    Set.remove ( d, u ) queue

                edges =
                    Dict.get u g |> Maybe.withDefault []

                ( q2, dist2 ) =
                    List.foldl
                        (\( v, w ) ( q, ds ) ->
                            let
                                nd =
                                    d + w
                            in
                            case Dict.get v ds of
                                Just old ->
                                    if old <= nd then
                                        ( q, ds )

                                    else
                                        ( Set.insert ( nd, v ) (Set.remove ( old, v ) q), Dict.insert v nd ds )

                                Nothing ->
                                    ( Set.insert ( nd, v ) q, Dict.insert v nd ds )
                        )
                        ( q1, dist )
                        edges
            in
            dijLoop g q2 dist2


gridW : Int
gridW =
    12


gridH : Int
gridH =
    8


walls : Set ( Int, Int )
walls =
    Set.fromList
        [ ( 3, 0 ), ( 3, 1 ), ( 3, 2 ), ( 3, 3 ), ( 3, 4 ), ( 3, 5 ), ( 7, 7 ), ( 7, 6 ), ( 7, 5 ), ( 7, 4 ), ( 7, 3 ), ( 7, 2 ), ( 7, 1 ) ]


bfs : ( Int, Int ) -> Dict ( Int, Int ) Int
bfs start =
    bfsLoop [ start ] [] (Dict.singleton start 0)


bfsLoop : List ( Int, Int ) -> List ( Int, Int ) -> Dict ( Int, Int ) Int -> Dict ( Int, Int ) Int
bfsLoop front back seen =
    case front of
        [] ->
            if List.isEmpty back then
                seen

            else
                bfsLoop (List.reverse back) [] seen

        ( x, y ) :: rest ->
            let
                d =
                    Dict.get ( x, y ) seen |> Maybe.withDefault 0

                ns =
                    [ ( x + 1, y ), ( x - 1, y ), ( x, y + 1 ), ( x, y - 1 ) ]
                        |> List.filter (\( a, b ) -> a >= 0 && b >= 0 && a < gridW && b < gridH)
                        |> List.filter (\p -> not (Set.member p walls) && not (Dict.member p seen))

                seen2 =
                    List.foldl (\p s -> Dict.insert p (d + 1) s) seen ns
            in
            bfsLoop rest (List.reverse ns ++ back) seen2


components : Graph -> List (List Int)
components g =
    Dict.keys g
        |> List.foldl
            (\k ( seen, acc ) ->
                if Set.member k seen then
                    ( seen, acc )

                else
                    let
                        comp =
                            dfs g [ k ] Set.empty
                    in
                    ( Set.union seen comp, Set.toList comp :: acc )
            )
            ( Set.empty, [] )
        |> Tuple.second
        |> List.reverse


dfs : Graph -> List Int -> Set Int -> Set Int
dfs g stack seen =
    case stack of
        [] ->
            seen

        u :: rest ->
            if Set.member u seen then
                dfs g rest seen

            else
                dfs g (List.map Tuple.first (Dict.get u g |> Maybe.withDefault []) ++ rest) (Set.insert u seen)


topo : Dict String (List String) -> Result String (List String)
topo deps =
    let
        step name ( done, visiting, out ) =
            visit name ( done, visiting, out )

        visit name ( done, visiting, out ) =
            if Set.member name done then
                Ok ( done, visiting, out )

            else if Set.member name visiting then
                Err ("cycle at " ++ name)

            else
                List.foldl
                    (\d acc -> Result.andThen (visit d) acc)
                    (Ok ( done, Set.insert name visiting, out ))
                    (Dict.get name deps |> Maybe.withDefault [])
                    |> Result.map (\( dn, vs, o ) -> ( Set.insert name dn, Set.remove name vs, name :: o ))
    in
    List.foldl (\n acc -> Result.andThen (step n) acc) (Ok ( Set.empty, Set.empty, [] )) (Dict.keys deps)
        |> Result.map (\( _, _, o ) -> List.reverse o)


results : List ( String, String )
results =
    let
        g =
            mkGraph [ ( 1, 2, 7 ), ( 1, 3, 9 ), ( 1, 6, 14 ), ( 2, 3, 10 ), ( 2, 4, 15 ), ( 3, 4, 11 ), ( 3, 6, 2 ), ( 4, 5, 6 ), ( 5, 6, 9 ), ( 10, 11, 1 ), ( 12, 12, 0 ) ]

        bf =
            bfs ( 0, 0 )
    in
    [ ( "dijkstra", Debug.toString (Dict.toList (dijkstra g 1)) )
    , ( "components", Debug.toString (components g) )
    , ( "bfs size", String.fromInt (Dict.size bf) )
    , ( "bfs far", Debug.toString (Dict.get ( 11, 7 ) bf) )
    , ( "bfs max", String.fromInt (Dict.foldl (\_ d m -> max d m) 0 bf) )
    , ( "bfs walled", Debug.toString (Dict.get ( 3, 3 ) bf) )
    , ( "topo ok", Debug.toString (topo (Dict.fromList [ ( "app", [ "lib", "util" ] ), ( "lib", [ "core" ] ), ( "util", [ "core" ] ), ( "core", [] ) ])) )
    , ( "topo cycle", Debug.toString (topo (Dict.fromList [ ( "a", [ "b" ] ), ( "b", [ "c" ] ), ( "c", [ "a" ] ) ])) )
    ]


main : Program () () ()
main =
    Platform.worker
        { init = \_ -> ( run results, Cmd.none )
        , update = \_ m -> ( m, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }


run : List ( String, String ) -> ()
run items =
    List.foldl (\( k, v ) _ -> always () (Debug.log k v)) () items
