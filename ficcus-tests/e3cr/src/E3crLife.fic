port module E3crLife exposing (main)

-- E3c review, items 1 and 3: a received Vector kept in the model, written in place, sent out again and dropped, so that a host can
-- keep pointers into it (ficcus-tests/e3cr/host/host_life.c); a Json.Value payload compared and printed.

import Json.Decode as D
import Json.Encode as E
import Vector exposing (Vector)
import Word8 exposing (Word8)


port output : String -> Cmd msg


port viOut : Vector Int -> Cmd msg


port vbOut : Vector Word8 -> Cmd msg


port jsonOut : E.Value -> Cmd msg


port viIn : (Vector Int -> msg) -> Sub msg


port vbIn : (Vector Word8 -> msg) -> Sub msg


port vlIn : (List (Vector Int) -> msg) -> Sub msg


port opIn : (Int -> msg) -> Sub msg


port jsonIn : (E.Value -> msg) -> Sub msg


type alias Model =
    { vi : Vector Int, vb : Vector Word8 }


type Msg
    = VI (Vector Int)
    | VB (Vector Word8)
    | VL (List (Vector Int))
    | Op Int
    | J E.Value


first : Vector Int -> String
first v =
    Maybe.withDefault "none" (Maybe.map String.fromInt (Vector.get 0 v))


update : Msg -> Model -> ( Model, Cmd Msg )
update msg m =
    case msg of
        VI v ->
            ( { m | vi = v }, output ("vi in " ++ String.fromInt (Vector.length v) ++ " first " ++ first v) )

        VB v ->
            ( { m | vb = v }, output ("vb in " ++ String.fromInt (Vector.length v)) )

        VL l ->
            ( { m | vi = Maybe.withDefault Vector.empty (List.head l) }, output ("vl in " ++ String.fromInt (List.length l)) )

        Op 0 ->
            ( { vi = Vector.empty, vb = Vector.empty }, output "dropped" )

        Op 1 ->
            let
                v =
                    Vector.set 0 999 m.vi
            in
            ( { m | vi = v }, output ("set first " ++ first v) )

        Op 2 ->
            ( m, viOut m.vi )

        Op 3 ->
            ( m, output ("first " ++ first m.vi) )

        Op 4 ->
            ( m, vbOut m.vb )

        Op _ ->
            ( m, Cmd.none )

        J v ->
            let
                again =
                    D.decodeString D.value (E.encode 0 v)
            in
            ( m
            , Cmd.batch
                [ output ("json " ++ E.encode 0 v)
                , output ("json eq reparsed " ++ (case again of
                                                       Ok w -> if w == v then "True" else "False"
                                                       Err _ -> "Err"))
                , output ("json toString " ++ Debug.toString v)
                , output ("json field a " ++ Debug.toString (D.decodeValue (D.field "a" D.value) v |> Result.map (E.encode 0)))
                , jsonOut v
                ]
            )


main : Program () Model Msg
main =
    Platform.worker
        { init = \_ -> ( { vi = Vector.empty, vb = Vector.empty }, Cmd.none )
        , update = update
        , subscriptions = \_ -> Sub.batch [ viIn VI, vbIn VB, vlIn VL, opIn Op, jsonIn J ]
        }
