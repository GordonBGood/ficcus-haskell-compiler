module G17 exposing (main)

-- Effects E2, G17 proper (docs/EFFECTS-CHECK.md section 3): the model protocol on the real scheduler. update on Step writes one Dict entry
-- and one Array slot and returns `Task.perform (\_ -> Step) (Task.succeed ())` until n = 0, then logs a checksum. 100000 steps, each a
-- process of the Task manager whose sendToApp runs the typed stepper. Expected (FIC_STATS model line): output = Elm, 0 model copies,
-- reuse misses O(1) per step. Elm runs the same program (no fold: the scheduler is real on both sides).

import Array exposing (Array)
import Dict exposing (Dict)
import Task


type alias Model =
    { a : Array Int, d : Dict Int Int, n : Int }


type Msg
    = Step


again : Cmd Msg
again =
    Task.perform (\_ -> Step) (Task.succeed ())


update : Msg -> Model -> ( Model, Cmd Msg )
update _ m =
    if m.n <= 0 then
        ( m, Cmd.none )

    else
        let
            k =
                modBy 1000 m.n

            m2 =
                { m | d = Dict.insert k m.n m.d, a = Array.set k m.n m.a, n = m.n - 1 }
        in
        if m2.n == 0 then
            ( logSum m2, Cmd.none )

        else
            ( m2, again )


logSum : Model -> Model
logSum m =
    let
        s =
            Dict.foldl (\k v acc -> acc + k * v) 0 m.d + Array.foldl (+) 0 m.a

        _ =
            Debug.log "checksum" ( s, Dict.size m.d, Array.length m.a )
    in
    m


main : Program () Model Msg
main =
    Platform.worker
        { init = \_ -> ( { a = Array.repeat 1000 0, d = Dict.empty, n = 100000 }, again )
        , update = update
        , subscriptions = \_ -> Sub.none
        }
