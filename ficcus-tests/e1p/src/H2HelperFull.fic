module H2HelperFull exposing (main)

import Array exposing (Array)
import Dict exposing (Dict)


type alias Model =
    { a : Array Int, d : Dict Int Int, n : Int }


type Msg
    = Step


initModel : Model
initModel =
    { a = Array.repeat 100 0, d = Dict.singleton 1 1, n = 1000 }


final : Model -> Model
final m =
    if m.n == 0 then
        Debug.log "final" { m | a = Array.slice 0 5 m.a }

    else
        m


update : Msg -> Model -> ( Model, Cmd Msg )
update _ m =
    ( final (setA m), Cmd.none )


setA : Model -> Model
setA m =
    { a = Array.set (modBy 100 m.n) m.n m.a, d = m.d, n = m.n - 1 }


main : Program () Model Msg
main =
    Platform.worker
        { init = \_ -> ( initModel, Cmd.none )
        , update = update
        , subscriptions = \_ -> Sub.none
        }
