module Main exposing (main)

{- Differential test main: lines  op|a|b|expected  (data below, made by bigint_cases.py) are run through BigInt and the printed
   result compared with the expected text. The same source builds with Ficcus (BigInt.fic) and with Elm (the package). -}

import BigInt exposing (BigInt)


data : String
data =
    """@DATA@"""


p : String -> BigInt
p s =
    case BigInt.fromIntString s of
        Just x ->
            x

        Nothing ->
            BigInt.fromInt 7777777


bs : BigInt -> String
bs =
    BigInt.toString


mb : Maybe BigInt -> String
mb m =
    case m of
        Nothing ->
            "Nothing"

        Just x ->
            bs x


bool : Bool -> String
bool b =
    if b then
        "True"

    else
        "False"


ord : Order -> String
ord o =
    case o of
        LT ->
            "LT"

        EQ ->
            "EQ"

        GT ->
            "GT"


run : String -> String -> String -> String -> String
run op a b e =
    case op of
        "add" ->
            bs (BigInt.add (p a) (p b))

        "sub" ->
            bs (BigInt.sub (p a) (p b))

        "mul" ->
            bs (BigInt.mul (p a) (p b))

        "canon" ->
            bool (BigInt.mul (p a) (p b) == p e) ++ "/" ++ e

        "canonadd" ->
            bool (BigInt.add (p a) (p b) == p e) ++ "/" ++ e

        "div" ->
            bs (BigInt.div (p a) (p b))

        "modBy" ->
            mb (BigInt.modBy (p a) (p b))

        "divmod" ->
            case BigInt.divmod (p a) (p b) of
                Nothing ->
                    "Nothing"

                Just ( q, r ) ->
                    bs q ++ "," ++ bs r

        "pow" ->
            bs (BigInt.pow (p a) (p b))

        "gcd" ->
            bs (BigInt.gcd (p a) (p b))

        "cmp" ->
            ord (BigInt.compare (p a) (p b))

        "lt" ->
            bool (BigInt.lt (p a) (p b))

        "gt" ->
            bool (BigInt.gt (p a) (p b))

        "lte" ->
            bool (BigInt.lte (p a) (p b))

        "gte" ->
            bool (BigInt.gte (p a) (p b))

        "max" ->
            bs (BigInt.max (p a) (p b))

        "min" ->
            bs (BigInt.min (p a) (p b))

        "neg" ->
            bs (BigInt.negate (p a))

        "abs" ->
            bs (BigInt.abs (p a))

        "even" ->
            bool (BigInt.isEven (p a))

        "odd" ->
            bool (BigInt.isOdd (p a))

        "toHex" ->
            BigInt.toHexString (p a)

        "hexRound" ->
            mb (BigInt.fromHexString (BigInt.toHexString (p a)))

        "fromInt" ->
            case String.toInt a of
                Just n ->
                    bs (BigInt.fromInt n)

                Nothing ->
                    "BAD-INT"

        "fromIntString" ->
            mb (BigInt.fromIntString a)

        "fromHexString" ->
            mb (BigInt.fromHexString a)

        _ ->
            "UNKNOWN-OP " ++ op


check : String -> Maybe String
check line =
    case String.split "|" line of
        [ op, a, b, e ] ->
            let
                got =
                    run op a b e

                want =
                    if op == "canon" || op == "canonadd" then
                        "True/" ++ e

                    else
                        e
            in
            if got == want then
                Nothing

            else
                Just (String.left 300 line ++ "  GOT " ++ String.left 300 got)

        _ ->
            Just ("BAD LINE " ++ line)


main : Program () () ()
main =
    Platform.worker
        { init =
            \_ ->
                let
                    lines =
                        String.lines data

                    fails =
                        List.filterMap check lines

                    _ =
                        List.map (\f -> Debug.log "FAIL" f) (List.take 20 fails)

                    _ =
                        Debug.log "cases" (List.length lines)

                    _ =
                        Debug.log "failed" (List.length fails)
                in
                ( (), Cmd.none )
        , update = \_ _ -> ( (), Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
