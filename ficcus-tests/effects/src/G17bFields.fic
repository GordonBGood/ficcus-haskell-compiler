module G17bFields exposing (main)

-- E1 step 3, G17b with an update that only reads fields of the model (never uses it whole): the ordinary borrow rules leave the
-- model parameter borrowed, so this is the case the seed is for (FICCUS_NO_MODEL_SEED=1 shows the copies). Otherwise as G17b.fic:
-- with a Dict, an Array and a counter; each `Step` writes one Dict entry and one Array slot. The test build runs N steps after init
-- (-DFIC_STEP_TEST=100000, the stepper's driver); the last step logs a checksum (the same line as ref/src/G17bRef.elm under Elm).
-- Expected (FIC_STATS model line): 0 model copies (copied = vec_copy = 0), every Array.set in place, reuse misses O(1) per step.
-- With FICCUS_NO_MODEL_SEED=1 the result shows what the seed is for.

import Array exposing (Array)
import Dict exposing (Dict)


type alias Model =
    { a : Array Int, d : Dict Int Int, n : Int }


type Msg
    = Step


size : Int
size =
    100000


update : Msg -> Model -> ( Model, Cmd Msg )
update _ m =
    if m.n <= 0 then
        ( { a = m.a, d = m.d, n = m.n }, Cmd.none )

    else
        let
            k =
                modBy 1000 m.n

            m2 =
                { d = Dict.insert k m.n m.d, a = Array.set k m.n m.a, n = m.n - 1 }
        in
        if m2.n == 0 then
            ( logSum m2, Cmd.none )

        else
            ( m2, Cmd.none )


logSum : Model -> Model
logSum m =
    let
        s =
            Dict.foldl (\k v acc -> acc + k * v) 0 m.d + Array.foldl (+) 0 m.a

        _ =
            Debug.log "checksum" ( s, Dict.size m.d, Array.length m.a )
    in
    m


main : Program () Model Msg
main =
    Platform.worker
        { init = \_ -> ( { a = Array.repeat 1000 0, d = Dict.empty, n = size }, Cmd.none )
        , update = update
        , subscriptions = \_ -> Sub.none
        }
