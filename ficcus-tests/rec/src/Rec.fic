module Rec exposing (count, evens, odds, result, wrap)


-- inferred mutual recursion at top level: one group, generalized together
evens xs =
    case xs of
        [] ->
            []

        x :: rest ->
            x :: odds rest


odds xs =
    case xs of
        [] ->
            []

        _ :: rest ->
            evens rest


-- annotated self recursion: inside its group the definition has its own annotation, not a fresh instance
count : List a -> Int
count xs =
    case xs of
        [] ->
            0

        _ :: rest ->
            1 + count rest


-- not recursive
wrap : a -> List a
wrap x =
    [ x ]


-- a let group of two mutually recursive local functions, used outside at two types
result : String
result =
    let
        ping n =
            if n <= 0 then
                []
            else
                "ping" :: pong (n - 1)

        pong n =
            if n <= 0 then
                []
            else
                "pong" :: ping (n - 1)

        twice f x =
            f (f x)
    in
    String.concat
        (ping 3
            ++ [ twice (\t -> t ++ "!") "a", String.fromInt (twice (\k -> k + 1) 0) ]
            ++ List.map String.fromInt (evens [ 1, 2, 3 ])
            ++ List.map String.fromInt (odds [ 4, 5 ])
            ++ [ String.fromInt (count [ 1, 2 ]), String.concat (wrap "w") ]
        )
