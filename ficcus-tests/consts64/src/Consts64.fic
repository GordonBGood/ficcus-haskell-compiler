module Consts64 exposing (main)

-- FIX3: constants built with the 64 bit Bitwise64 operations are folded at compile time. Ficcus only (no Elm output): the expected
-- output is what the unfolded program (compiler elmficA15, constants computed at run time) prints.

import Bitwise64 as Bit


limbBits : Int
limbBits =
    31


base : Int
base =
    Bit.shiftLeftBy limbBits 1


mask : Int
mask =
    base - 1


allOnes : Int
allOnes =
    Bit.complement 0


top : Int
top =
    Bit.shiftLeftBy 63 1


arith : Int
arith =
    Bit.shiftRightBy 60 top


logical : Int
logical =
    Bit.shiftRightZfBy 60 top


count65 : Int
count65 =
    Bit.shiftLeftBy 65 3


mixed : Int
mixed =
    Bit.xor (Bit.or mask 4096) (Bit.and base 12345)


wrapped : Int
wrapped =
    base * base * base * 4 + 1


neg : Int
neg =
    -(base * 3)


main : Program () () ()
main =
    Platform.worker
        { init =
            \_ ->
                let
                    _ =
                        Debug.log "consts" [ limbBits, base, mask, allOnes, top, arith, logical, count65, mixed, wrapped, neg ]

                    _ =
                        Debug.log "runtime" [ Bit.shiftLeftBy limbBits (List.length [ 1 ]), mask - List.length [ 1 ], Bit.and mask (negate (List.length [ 1, 2 ])) ]
                in
                ( (), Cmd.none )
        , update = \_ _ -> ( (), Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
