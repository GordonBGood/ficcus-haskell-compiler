module E1pR13TailBranch exposing (main)

import Array exposing (Array)
import Dict exposing (Dict)


type alias Model =
    { a : Array Int, d : Dict Int Int, n : Int }


initModel : Model
initModel =
    { a = Array.repeat 100 0, d = Dict.singleton 1 1, n = 0 }


setA : Model -> Model
setA m =
    { m | a = Array.set (modBy 100 m.n) (m.n + 1) m.a, n = m.n + 1 }


show : Model -> ( List Int, List ( Int, Int ), Int )
show m =
    ( Array.toList (Array.slice 0 8 m.a), List.take 5 (Dict.toList m.d), m.n )


loop : Int -> Model -> Model
loop k m =
    if k == 0 then
        m

    else
        loop (k - 1) (step k m)


main : Program () () ()
main =
    Platform.worker
        { init = \_ -> ( always () (Debug.log "r" (show (loop 300000 initModel))), Cmd.none )
        , update = \_ m -> ( m, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }



-- H9: m is rebuilt on one branch, returned whole on another, passed whole to a writing helper on a third, and wrapped in a
-- nested record on a fourth
step : Int -> Model -> Model
step k m =
    if modBy 3 k == 0 then
        { m | d = Dict.insert (modBy 7 k) m.n m.d }

    else if modBy 5 k == 0 then
        m

    else if modBy 7 k == 0 then
        (stepOuter k { inner = m, tag = [ k ] }).inner

    else
        setA m


-- H13: the loop above is a self tail call of 300000 iterations (it must stay a loop in C after the split); and a nested record
-- split again (`{ o | inner = { i | .. } }`) on every 7th step
type alias Outer =
    { inner : Model, tag : List Int }


stepOuter : Int -> Outer -> Outer
stepOuter k o =
    let
        i =
            o.inner
    in
    { o | inner = { i | a = Array.set (modBy 100 i.n) (k + List.length o.tag) i.a, n = i.n + 1 }, tag = [] }
