module Lists exposing (main)

-- Slice 3b: the List functions of elm/core compiled from their Elm source, specialized per class of their
-- variables (List.map at Int -> Int, Int -> String, String -> String, record -> Int, ...). Compared with Elm.


type Shape
    = Circle Float
    | Rect Float Float


area : Shape -> Float
area shape =
    case shape of
        Circle r ->
            3.0 * r * r

        Rect w h ->
            w * h


join : List String -> String
join strs =
    List.foldl (\s acc -> acc ++ s ++ ";") "" strs


showInts : List Int -> String
showInts ns =
    join (List.map String.fromInt ns)


main : Program () () ()
main =
    Platform.worker
        { init =
            \_ ->
                let
                    ints =
                        List.range 1 10

                    shapes =
                        [ Circle 1.0, Rect 2.0 3.0, Circle 2.0 ]

                    pairs =
                        List.map (\n -> ( n, n * n )) ints

                    _ =
                        Debug.log "range" (showInts ints)

                    _ =
                        Debug.log "map int int" (showInts (List.map (\n -> n * 3) ints))

                    _ =
                        Debug.log "map int string" (join (List.map String.fromInt ints))

                    _ =
                        Debug.log "map string string" (join (List.map (\s -> s ++ s) [ "a", "bc" ]))

                    _ =
                        Debug.log "map shape float" (List.foldl (+) 0.0 (List.map area shapes))

                    _ =
                        Debug.log "map tuple" (List.foldl (\( a, b ) acc -> acc + a + b) 0 pairs)

                    _ =
                        Debug.log "filter" (showInts (List.filter (\n -> n > 7) ints))

                    _ =
                        Debug.log "length" (List.length ints + List.length shapes)

                    _ =
                        Debug.log "reverse" (showInts (List.reverse ints))

                    _ =
                        Debug.log "foldl" (List.foldl (\n acc -> acc * 2 + n) 0 [ 1, 0, 1, 1 ])

                    _ =
                        Debug.log "foldr" (List.foldr (\n acc -> acc * 2 + n) 0 [ 1, 0, 1, 1 ])

                    _ =
                        Debug.log "sum" (List.sum ints)

                    _ =
                        Debug.log "sum float" (List.sum [ 0.5, 0.25 ])

                    _ =
                        Debug.log "product" (List.product [ 1, 2, 3, 4 ])

                    _ =
                        Debug.log "append" (showInts (List.append [ 1, 2 ] [ 3 ]))

                    _ =
                        Debug.log "concat" (showInts (List.concat [ [ 1 ], [ 2, 3 ], [] ]))

                    _ =
                        Debug.log "concatMap" (showInts (List.concatMap (\n -> [ n, n ]) [ 1, 2 ]))

                    _ =
                        Debug.log "take drop" (showInts (List.take 3 (List.drop 2 ints)))

                    _ =
                        Debug.log "repeat" (showInts (List.repeat 3 7))

                    _ =
                        Debug.log "any all" (List.length (List.filter (\b -> b) [ List.any (\n -> n > 9) ints, List.all (\n -> n > 0) ints, List.isEmpty ints ]))

                    _ =
                        Debug.log "head" (Maybe.withDefault -1 (List.head ints))

                    _ =
                        Debug.log "maximum" (Maybe.withDefault -1 (List.maximum [ 3, 9, 2 ]))

                    _ =
                        Debug.log "filterMap" (showInts (List.filterMap (\n -> if n > 8 then Just (n * 2) else Nothing) ints))

                    _ =
                        Debug.log "partition" (showInts (Tuple.first (List.partition (\n -> n > 5) ints)))

                    _ =
                        Debug.log "unzip" (showInts (Tuple.second (List.unzip pairs)))
                in
                ( (), Cmd.none )
        , update = \_ _ -> ( (), Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
